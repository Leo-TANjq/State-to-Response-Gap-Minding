MODEL_PATH=Qwen/Qwen3-8B
TRAIN_FILE=/path/to/humanlm/train.parquet
VAL_FILE=/path/to/humanlm/val.parquet
OUTPUT_DIR=/path/to/checkpoints/qwen3-8b
CACHE_DIR=/path/to/cache
GPU_LIST=0
VERL_DIR=/path/to/verl
TRAIN_JUDGE_MODEL=provider/model-name
EVAL_JUDGE_MODEL=provider/model-name

LORA_RANK=16
LORA_ALPHA=32
TRAIN_BATCH_SIZE=32
PPO_MINI_BATCH_SIZE=4
TOTAL_EPOCHS=1
TOTAL_TRAINING_STEPS=200

ROLLOUTS=4
MAX_PROMPT_LENGTH=5120
MAX_RESPONSE_LENGTH=1024
GPU_MEMORY_UTILIZATION=0.30
TRAIN_TEMPERATURE=0.8
LEARNING_RATE=1e-6
KL_COEFFICIENT=0.001
SAVE_FREQUENCY=50
